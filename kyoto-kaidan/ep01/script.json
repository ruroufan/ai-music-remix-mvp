{
  "id": "ep01",
  "series": "京都怪谈",
  "title": "一条戻桥",
  "night": "第一夜",
  "voices": {
    "narrator": {"sid": 58, "speed": 1.04},
    "woman":    {"sid": 10, "speed": 1.05},
    "granny":   {"sid": 13, "speed": 1.0}
  },
  "tts_replace": {"戻": "戾", "——": "，"},
  "lines": [
    {"id": "L01", "voice": "narrator", "text": "他在京都的一座桥上，砍下了鬼的一条手臂。"},
    {"id": "L02", "voice": "narrator", "text": "到了第六天，来取手臂的人，敲响了他的家门。"},
    {"id": "L03", "voice": "narrator", "text": "这座桥，叫一条戻桥。"},
    {"id": "L04", "voice": "narrator", "text": "传说，武士渡边纲曾在深夜骑马经过这里。"},
    {"id": "L05", "voice": "narrator", "text": "桥边，一个年轻女子拦住了他。"},
    {"id": "L06", "voice": "woman",    "text": "“夜路太黑，能送我一程吗？”"},
    {"id": "L07", "voice": "narrator", "text": "他让女子上了马。"},
    {"id": "L08", "voice": "narrator", "text": "走到桥上时，他无意间低头，看了一眼河面。"},
    {"id": "L09", "voice": "narrator", "text": "马背上，女子安静地坐着。"},
    {"id": "L10", "voice": "narrator", "text": "水里的那张脸，却长着角。"},
    {"id": "L11", "voice": "narrator", "text": "他刚摸到刀柄，一只手就掐住了他的脖子，将他拽向半空。"},
    {"id": "L12", "voice": "narrator", "text": "渡边纲拔刀一挥。"},
    {"id": "L13", "voice": "narrator", "text": "一条手臂落了下来。"},
    {"id": "L14", "voice": "narrator", "text": "鬼挣脱出去，消失在夜色里。"},
    {"id": "L15", "voice": "narrator", "text": "捡回一条命的渡边纲，把那条断臂带回家，放进木箱，用绳子封好。"},
    {"id": "L16", "voice": "narrator", "text": "第一夜，平安无事。"},
    {"id": "L17", "voice": "narrator", "text": "第二夜，也没有动静。"},
    {"id": "L18", "voice": "narrator", "text": "直到第六天。"},
    {"id": "L19", "voice": "narrator", "text": "门，响了。", "speed": 0.92},
    {"id": "L20", "voice": "narrator", "text": "渡边纲开门，看见自己的祖母站在外面。"},
    {"id": "L21", "voice": "granny",   "text": "“听说你斩了鬼。让我看看吧。”"},
    {"id": "L22", "voice": "narrator", "text": "他把老人请进屋，解开封绳，慢慢掀起箱盖。"},
    {"id": "L23", "voice": "narrator", "text": "老人凑近了一些。"},
    {"id": "L24", "voice": "narrator", "text": "然后，伸手抓住了那条断臂。"},
    {"id": "L25", "voice": "narrator", "text": "渡边纲抬起头。"},
    {"id": "L26", "voice": "narrator", "text": "眼前那张熟悉的脸，变了。"},
    {"id": "L27", "voice": "narrator", "text": "下一刻，鬼撞破屋顶，带着手臂，飞进了夜色。"},
    {"id": "L28", "voice": "narrator", "text": "屋里，只剩下一只空箱。"},
    {"id": "L29", "voice": "narrator", "text": "渡边纲站在原地。"},
    {"id": "L30", "voice": "narrator", "text": "他刚才，还叫了她一声——", "speed": 0.92},
    {"id": "L31", "voice": "narrator", "text": "祖母。", "speed": 0.913}
  ]
}
