{
  "name": "explainer-video",
  "private": true,
  "version": "0.1.0",
  "description": "Remotion template for dark-theatre style explainer videos (silhouettes, spotlights, serif subtitles)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Explainer out/explainer.mp4",
    "still": "remotion still src/index.ts Explainer out/still.png --frame=300",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "5.3.0",
    "@remotion/cli": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
