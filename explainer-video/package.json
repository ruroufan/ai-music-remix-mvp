{
  "name": "explainer-video",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Remotion template for code-drawn explainer videos with beat-synced subtitles and a synthesized score",
  "scripts": {
    "prestudio": "node scripts/music.mjs",
    "studio": "remotion studio src/index.ts",
    "music": "node scripts/music.mjs",
    "voiceover": "node scripts/voiceover.mjs",
    "prerender": "node scripts/music.mjs pleasing",
    "render": "remotion render src/index.ts Pleasing out/pleasing.mp4",
    "render:pride": "node scripts/music.mjs pride && remotion render src/index.ts Pride out/pride.mp4",
    "still": "remotion still src/index.ts Pleasing out/still.png --frame=300",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@remotion/cli": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
